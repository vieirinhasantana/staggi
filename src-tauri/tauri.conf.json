{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "staggi",
  "version": "0.1.1",
  "identifier": "app.staggi",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Staggi",
        "width": 800,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE0M0JGQzA5MzU2RjUxRDcKUldUWFVXODFDZnc3cE1tTWJMYWZlcGptRENmTDRGeGJrM29vaUttNHNaemVHRkFtUnZYckNiTTcK",
      "endpoints": [
        "https://github.com/vieirinhasantana/staggi/releases/latest/download/latest.json"
      ]
    }
  }
}
